
pipeline {
    agent {
        label 'yocto-build-node'
    }

    options {
        timeout(time: 4, unit: 'HOURS')
        timestamps ()
    }

    stages {

        stage('Clone Repositories') {
            steps {
                script {
        
                    sh 'mkdir -p customlayer'
        
                    echo "Cloning Poky repository..."
        
                    dir("${WORKSPACE}/poky") {
                        git branch: 'kirkstone',
                            url: 'https://git.yoctoproject.org/git/poky'
                    }
        
                    echo "Cloning custom layer repository..."
        
                    dir("${WORKSPACE}/customlayer") {
                        git branch: 'main',
                            url: 'https://github.com/YerawarPooja/yocto-build-demo.git'
        
                        sh """
                            cp -r meta-myhelloworld ${WORKSPACE}/poky/
                        """
                    }
                }
            }
        }

        stage('Configure Build Environment and Build Image') {
            steps {
                script {
                    sh '''
                    bash -c "
                    export TEMPLATECONF=${WORKSPACE}/poky/meta-myhelloworld/template/default
                    cd poky
                    source oe-init-build-env build
                    bitbake core-image-minimal
                    "
                    '''
                }
            }
        }
    }

    post {
      /*  always {

           
            cleanWs()
        } */
        success {
            echo "Yocto image build SUCCEEDED!"

        }
        failure {
            echo "Yocto image build FAILED!"
        }
        unstable {
            echo "Yocto image build UNSTABLE (e.g., some tests failed)."
        }
    }
}
