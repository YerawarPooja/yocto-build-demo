            }
        }

        stage('Configure Build Environment and Build Image') {
            steps {
                script {
                    sh '''
                    bash -c "
                    export TEMPLATECONF=${WORKSPACE}/poky/meta-myhelloworld/conf/template/default
                    cd poky
                    source oe-init-build-env build
                    bitbake core-image-minimal
                    "
                    '''
                }
            }
        } 

        stage('Sign Artifact') {
            steps {
                withCredentials([
                    string(credentialsId: 'yocto-passphrase', variable: 'GPG_PASSPHRASE')
                ]) {
                    sh '''
                    #!/bin/bash -e
                    cd poky
                    ARTIFACT="build/tmp/deploy/images/qemux86-64/core-image-minimal-qemux86-64.tar.bz2"
        
                    echo "===== Verifying Artifact Exists ====="
                    if [ ! -f "$ARTIFACT" ]; then
                        echo "ERROR: Artifact not found: $ARTIFACT"
                        exit 1
                    fi
        
                    ls -lh "$ARTIFACT"
        
                    echo "===== Signing Artifact ====="
                    gpg --batch \
                        --yes \
                        --pinentry-mode loopback \
                        --passphrase "$GPG_PASSPHRASE" \
                        --detach-sign \
                        --armor \
                        "$ARTIFACT"
        
                    SIG_FILE="${ARTIFACT}.asc"
        
                    echo "===== Verifying Signature File ====="
                    if [ ! -f "$SIG_FILE" ]; then
                        echo "ERROR: Signature file was not generated."
                        exit 1
                    fi
        
                    ls -lh "$SIG_FILE"
        
                    echo "===== Verifying GPG Signature ====="
                    gpg --verify "$SIG_FILE" "$ARTIFACT"
        
                    echo "===== SHA256 Checksums ====="
                    sha256sum "$ARTIFACT"
                    sha256sum "$SIG_FILE"
        
                    echo "Artifact signing and verification completed successfully."
                    '''
                }
            }
        } */

        stage('Upload Artifacts to S3') {
            steps {
                sh '''
                DEPLOY_DIR="build/tmp/deploy/images/qemux86-64"
                RELEASE="v${BUILD_NUMBER}"
        
                aws s3 sync \
                    ${DEPLOY_DIR}/ \
                    s3://yocto-release-artifacts/releases/${RELEASE}/
                '''
            }
        }
    }

    post {
      /*  always {

           
            cleanWs()
        } */
        success {
            echo "Yocto image build SUCCEEDED!"

        }
        failure {
            echo "Yocto image build FAILED!"
        }
        unstable {
            echo "Yocto image build UNSTABLE (e.g., some tests failed)."
        }
    }
}
